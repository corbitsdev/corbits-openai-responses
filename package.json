{
  "name": "@corbits/openai-responses",
  "version": "0.2.0",
  "description": "Interchange ProviderAdapter for the OpenAI Responses API wire protocol with quirks-based vendor configuration, SSE and non-streaming parsing, and reasoning signature replay.",
  "keywords": [
    "corbits",
    "inference",
    "interchange",
    "openai",
    "responses"
  ],
  "homepage": "https://github.com/corbitsdev/corbits-openai-responses#readme",
  "bugs": {
    "url": "https://github.com/corbitsdev/corbits-openai-responses/issues"
  },
  "license": "LGPL-2.1-only",
  "author": "Sawyer Cutler <sawyer@dirtroad.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corbitsdev/corbits-openai-responses.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "bun test src --pass-with-no-tests",
    "test:e2e": "bun test e2e",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test"
  },
  "dependencies": {
    "arktype": "2.2.3"
  },
  "devDependencies": {
    "@intx/inference": "0.4.0",
    "@intx/inference-testing": "0.4.0",
    "@intx/types": "0.4.0",
    "@types/bun": "1.3.14",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "@intx/inference": "^0.4.0",
    "@intx/types": "^0.4.0"
  },
  "engines": {
    "bun": ">=1.2.0",
    "node": ">=24"
  }
}
