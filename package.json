{
  "name": "@corbits/openai-responses",
  "version": "0.1.0",
  "description": "Interchange ProviderAdapter for the OpenAI Responses API wire protocol with quirks-based vendor configuration, SSE and non-streaming parsing, and reasoning signature replay.",
  "license": "LGPL-2.1-only",
  "author": "Sawyer Cutler <sawyer@dirtroad.dev>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test"
  },
  "dependencies": {
    "arktype": "2.2.3"
  },
  "peerDependencies": {
    "@intx/inference": "^0.4.0",
    "@intx/types": "^0.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@intx/inference": "0.4.0",
    "@intx/inference-testing": "0.4.0",
    "@intx/types": "0.4.0",
    "@types/bun": "1.3.14",
    "eslint": "10.10.0",
    "jiti": "2.7.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0"
  },
  "engines": {
    "bun": ">=1.2.0",
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corbitsdev/corbits-openai-responses.git"
  },
  "homepage": "https://github.com/corbitsdev/corbits-openai-responses",
  "bugs": {
    "url": "https://github.com/corbitsdev/corbits-openai-responses/issues"
  }
}
